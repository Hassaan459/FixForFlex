{
  "manifest_version": 3,
  "name": "FixForFlex",
  "short_name": "FixForFlex",
  "version": "3.0",
  "description": "A FLEX portal enhancer: a cleaner, readable FLEX with course totals, attendance and transcript tools, and alerts when your marks change.",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://flexstudent.nu.edu.pk/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FixForFlex: check marks now"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flexstudent.nu.edu.pk/*"
      ],
      "js": [
        "content/theme.js"
      ],
      "css": [
        "content/theme.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://flexstudent.nu.edu.pk/*"
      ],
      "css": [
        "content/topbar.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://flexstudent.nu.edu.pk/*"
      ],
      "css": [
        "content/loader.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://flexstudent.nu.edu.pk/*"
      ],
      "js": [
        "content/sidebar.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://flexstudent.nu.edu.pk/Student/StudentMarks*"
      ],
      "js": [
        "content/marks.js"
      ],
      "css": [
        "content/marks.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://flexstudent.nu.edu.pk/Student/StudentAttendance*"
      ],
      "js": [
        "content/attendance.js"
      ],
      "css": [
        "content/attendance.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://flexstudent.nu.edu.pk/Student/Transcript*"
      ],
      "js": [
        "content/transcript.js"
      ],
      "css": [
        "content/transcript.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://flexstudent.nu.edu.pk/*"
      ],
      "js": [
        "content/login.js"
      ],
      "css": [
        "content/login.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://flexstudent.nu.edu.pk/*"
      ],
      "js": [
        "content/home.js"
      ],
      "css": [
        "content/home.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://flexstudent.nu.edu.pk/Student/PrintAdmitCard*"
      ],
      "js": [
        "content/admitcard.js"
      ],
      "css": [
        "content/admitcard.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://flexstudent.nu.edu.pk/Student/_AdmitCardByRollNoP*"
      ],
      "js": [
        "content/admitcard-print.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://flexstudent.nu.edu.pk/Student/Challan*",
        "https://flexstudent.nu.edu.pk/ConsolidatedFeeReport/*"
      ],
      "js": [
        "content/fee.js"
      ],
      "css": [
        "content/fee.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://flexstudent.nu.edu.pk/Student/PrintStdChallanForm*",
        "https://flexstudent.nu.edu.pk/Student/ChallanForm*"
      ],
      "js": [
        "content/fee-print.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://flexstudent.nu.edu.pk/Student/CourseRegistration*"
      ],
      "css": [
        "content/registration.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://flexstudent.nu.edu.pk/Student/CourseRegistration*"
      ],
      "js": [
        "content/registration.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://flexstudent.nu.edu.pk/Student/TentativeStudyPlan*"
      ],
      "css": [
        "content/studyplan.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://flexstudent.nu.edu.pk/Student/GradeReport*"
      ],
      "css": [
        "content/gradereport.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://flexstudent.nu.edu.pk/Student/GradeReport*"
      ],
      "js": [
        "content/gradereport.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "https://flexstudent.nu.edu.pk/*"
      ]
    }
  ]
}

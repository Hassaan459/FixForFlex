{
  "manifest_version": 3,
  "name": "FixForFlex",
  "short_name": "FixForFlex",
  "version": "1.0.1",
  "description": "A FLEX portal enhancer: a cleaner, readable FLEX with course totals, attendance and transcript tools, and alerts when your marks change.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "tabs",
    "offscreen",
    "scripting",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://flexstudent.nu.edu.pk/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FixForFlex",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2",
        "icons/flex-mark.svg"
      ],
      "matches": [
        "https://flexstudent.nu.edu.pk/*"
      ]
    }
  ]
}
